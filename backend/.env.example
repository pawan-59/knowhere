# ── Server ───────────────────────────────────────────────────────────────
PORT=8080
ALLOW_ORIGIN=http://localhost:5173
CACHE_TTL_SECONDS=60

# ── Authentication ─────────────────────────────────────────────────────────
# AUTH_SECRET signs session cookies. MUST be set in production (>=32 random
# chars). Generate with:  openssl rand -base64 48
AUTH_SECRET=
# Session lifetime before re-login is required.
AUTH_TOKEN_TTL_SECONDS=43200
# Set true when serving over HTTPS so the session cookie is HTTPS-only.
COOKIE_SECURE=false
# Initial admin account, created/updated on startup. Password >= 8 chars.
ADMIN_EMAIL=admin@devtron.ai
ADMIN_PASSWORD=change-me-now-8+chars

# ── Database (embedded SQLite — license + onboarding + users) ───────────────
# Path to the SQLite file. Locally this is a file in the working dir; in a
# container/pod point it at a mounted volume (e.g. /data/central.db) so data
# survives restarts.
DB_PATH=central.db

# ── Zoho Desk (India data center) ──────────────────────────────────────────
# Create a Self Client in https://api-console.zoho.in to obtain these.
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.in
ZOHO_API_BASE=https://desk.zoho.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=

# ── Devtron orchestrator ───────────────────────────────────────────────────
DEVTRON_BASE_URL=https://devtron.example.com
DEVTRON_API_TOKEN=
